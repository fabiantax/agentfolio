# veld-extractors-gliformer — Knowledgator GLiFormer backend for the veld
# /ner + /extract wire contract (+ AgentFolio demo UI, browser-local LFM
# chat, domain bootstrap, OTel observability).
#
# Stage 1 (bundler): bun bundles transformers.js into a self-contained ESM
#   file + copies the ort wasm runtime — served same-origin from /assets.
#   ZERO external CDN deps in the browser (iOS content blockers killed the
#   jsdelivr import — "Load failed" with no server request, 2026-09-16).
# Stage 2 (runtime): python 3.12, CPU torch, gliformer, OTel SDK; GLiFormer
#   AND the browser LFM2.5-350M ONNX weights baked in (reproducibility over
#   size). Memory: fp32 load peaks >2GiB — run with >=3g cap (measured).
FROM oven/bun:1 AS bundler
WORKDIR /src
RUN echo 'import * as tf from "@huggingface/transformers"; \
export const { pipeline, env, TextStreamer, AutoTokenizer } = tf; \
export default tf;' > entry.ts \
 && bun add @huggingface/transformers@3.7.5 >/dev/null 2>&1 \
 && bun build entry.ts --target=browser --outfile=transformers.bundle.mjs --minify \
 && mkdir -p /out/ort \
 && cp transformers.bundle.mjs /out/ \
 && cp node_modules/@huggingface/transformers/dist/ort-wasm-simd-threaded.jsep.* /out/ort/ \
 && ls -la /out /out/ort

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/models/hf-cache \
    TOKENIZERS_PARALLELISM=false \
    GLIFORMER_MODEL=knowledgator/gliformer-base-v1 \
    GLIFORMER_DEVICE=cpu \
    OTEL_ENABLED=1 \
    OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates && rm -rf /var/lib/apt/lists/*

RUN pip install --index-url https://download.pytorch.org/whl/cpu torch

RUN pip install \
    "fastapi==0.115.0" \
    "uvicorn[standard]==0.32.0" \
    "gliformer==0.1.2" \
    "opentelemetry-sdk==1.29.0" \
    "opentelemetry-exporter-otlp-proto-http==1.29.0" \
    "opentelemetry-instrumentation-fastapi==0.50b0"

# GLiFormer checkpoint (server-side extraction model), offline-capable.
RUN HF_HUB_DOWNLOAD_TIMEOUT=120 python -c "from huggingface_hub import snapshot_download; \
    p = snapshot_download('knowledgator/gliformer-base-v1', max_workers=2); \
    print('downloaded to', p)"

# Browser model (LFM2.5-350M ONNX, both dtypes) in HF layout so
# transformers.js points at this same origin — repeat /local loads hit the
# browser disk cache, zero HF round-trips.
RUN M=/models/hf/onnx-community/LFM2.5-350M-ONNX/resolve/main && \
    mkdir -p $M/onnx && cd $M && \
    for f in config.json generation_config.json tokenizer.json \
             tokenizer_config.json special_tokens_map.json; do \
      curl -fsSL --retry 3 -o $f \
        "https://huggingface.co/onnx-community/LFM2.5-350M-ONNX/resolve/main/$f" \
        || true; \
    done && \
    for f in model_q4.onnx model_q4.onnx_data model_q4f16.onnx model_q4f16.onnx_data; do \
      curl -fsSL --retry 3 -o onnx/$f \
        "https://huggingface.co/onnx-community/LFM2.5-350M-ONNX/resolve/main/onnx/$f"; \
    done && ls -la onnx/

# Browser JS assets from the bundler stage.
COPY --from=bundler /out/transformers.bundle.mjs /assets/transformers.bundle.mjs
COPY --from=bundler /out/ort/ /assets/ort/

WORKDIR /app
COPY otel_setup.py /app/otel_setup.py
COPY gliformer_main.py /app/gliformer_main.py
COPY demo.html /app/demo.html
COPY local-chat.html /app/local-chat.html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=180s \
    CMD curl -sf http://127.0.0.1:8080/health || exit 1

CMD ["uvicorn", "gliformer_main:app", "--host", "0.0.0.0", "--port", "8080"]
