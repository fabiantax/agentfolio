# veld-extractors-gliformer — Knowledgator GLiFormer backend for the veld
# /ner + /extract wire contract (third backend next to gliner2 + gliner-relex;
# separate image per veld venv discipline — pins are mutually incompatible).
#
# - Model:  knowledgator/gliformer-base-v1 (2026-09-11, Apache-2.0)
# - CPU-only torch (demo VMs are CPU; saves ~2 GB vs the CUDA wheel)
# - Model baked in (veld pattern: reproducibility over image size)
# - Smoke-tested on strix CPU 2026-09-15: NER 94 ms / joint-rel 64 ms
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/models/hf-cache \
    TOKENIZERS_PARALLELISM=false \
    GLIFORMER_MODEL=knowledgator/gliformer-base-v1 \
    GLIFORMER_DEVICE=cpu

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates && rm -rf /var/lib/apt/lists/*

RUN pip install --index-url https://download.pytorch.org/whl/cpu torch

RUN pip install \
    "fastapi==0.115.0" \
    "uvicorn[standard]==0.32.0" \
    "gliformer==0.1.2" \
    "opentelemetry-sdk==1.29.0" \
    "opentelemetry-exporter-otlp-proto-http==1.29.0" \
    "opentelemetry-instrumentation-fastapi==0.50b0"

# Self-host the browser JS stack (v0.1.8): transformers.js ESM bundle +
# the exact pinned onnxruntime-web wasm assets, served from /assets —
# ZERO external CDN deps (iOS content blockers killed the jsdelivr import;
# "Load failed" on iPhone, no server request ever arrived).
RUN ORT=onnxruntime-web@1.22.0-dev.20250409-89f8206ba4 && \
    mkdir -p /assets/ort && \
    curl -fsSL --retry 3 -o /assets/transformers.min.mjs \
      "https://cdn.jsdelivr.net/npm/@huggingface/transformers@3.7.5/dist/transformers.min.mjs" && \
    curl -s "https://data.jsdelivr.com/v1/package/npm/$ORT/flat" \
      | python3 -c "import json,sys; [print(f['name']) for f in json.load(sys.stdin)['files'] if f['name'].startswith('/dist/') and (f['name'].endswith('.wasm') or '.mjs' in f['name']) and 'bundle' not in f['name']]" \
      > /tmp/ort-files.txt && \
    wc -l /tmp/ort-files.txt && \
    while read -r f; do curl -fsSL --retry 3 -o "/assets/ort/$(basename $f)" \
      "https://cdn.jsdelivr.net/npm/$ORT$f"; done < /tmp/ort-files.txt && \
    ls -la /assets/ort/ | head -20

# Bake the checkpoint (offline-capable container).
RUN HF_HUB_DOWNLOAD_TIMEOUT=120 python -c "from huggingface_hub import snapshot_download; \
    p = snapshot_download('knowledgator/gliformer-base-v1', max_workers=2); \
    print('downloaded to', p)"

# Bake the BROWSER model too (LFM2.5-350M ONNX, both dtypes) in HF layout so
# transformers.js can be pointed at this same origin (env.remoteHost) —
# repeat /local loads hit the browser disk cache, zero HF round-trips.
RUN M=/models/hf/onnx-community/LFM2.5-350M-ONNX/resolve/main && \
    mkdir -p $M/onnx && cd $M && \
    for f in config.json generation_config.json tokenizer.json \
             tokenizer_config.json special_tokens_map.json; do \
      curl -fsSL --retry 3 -o $f \
        "https://huggingface.co/onnx-community/LFM2.5-350M-ONNX/resolve/main/$f" \
        || true; \
    done && \
    for f in model_q4.onnx model_q4.onnx_data model_q4f16.onnx model_q4f16.onnx_data; do \
      curl -fsSL --retry 3 -o onnx/$f \
        "https://huggingface.co/onnx-community/LFM2.5-350M-ONNX/resolve/main/onnx/$f"; \
    done && ls -la onnx/

WORKDIR /app
COPY otel_setup.py /app/otel_setup.py
COPY gliformer_main.py /app/gliformer_main.py
COPY demo.html /app/demo.html
COPY local-chat.html /app/local-chat.html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=180s \
    CMD curl -sf http://127.0.0.1:8080/health || exit 1

CMD ["uvicorn", "gliformer_main:app", "--host", "0.0.0.0", "--port", "8080"]
